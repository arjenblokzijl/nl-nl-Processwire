            "text": "Kies bestand"
        },
        "96baacdc276036c2b8fb65264750a3b4": {
            "text": "Bestanden kiezen"
        },
        "e72ce31f0ee80699eb03ad6cc894fe3a": {
            "text": "Niet-ondersteunde bestandsextensie, gebruik alleen: EXTENSIONS"
        },
        "6ebd01ddd3a5422eb7dcdd0ce4b677c7": {
            "text": "Het bestand is te groot – de maximaal toegestane grootte is MAX_KB kb"
        },
        "004a10c5de4a2eea5fc8f15e97a8030c": {
            "text": "Er zijn geen extensies gedefinieerd voor dit veld."
        },
        "e8b3e55c0f4d6cce7d8ee14772ec33e2": {
            "text": "Bestand is niet gevalideerd"
        },
        "1a6d5576222d1a16320dda443f43b1fa": {
            "text": "Bestand toegevoegd:"
        },
        "5d28dcd09c5073bb0e454aee16d9b349": {
            "text": "Bestand %s is geweigerd omdat het al aanwezig is in het bestandssysteem en in een ander veld (field) wordt gebruikt."
        },
        "a2c68b109a7c8855b92e56e64bdf4c01": {
            "text": "Bestand verwijderd:"
        },
        "b15dd49c58da836d9802f6e9e063a998": {
            "text": "Bestand “%1$s” hernoemd naar “%2$s”"
        },
        "d7c8c85bf79bbe1b7188497c32c3b0ca": {
            "text": "Mislukt"
        },
        "cde86841445e53259c5beb7b61aaf389": {
            "text": "destinationPath bestaat niet of is leeg"
        },
        "53fbb1f98e15224437792f2ea80847a2": {
            "text": "destinationPath is niet schrijfbaar"
        },
        "b896cdc3267a288d8a0082126a91cb06": {
            "text": "Limiet voor het uploaden van bestanden is bereikt."
        },
        "c62fc670ac122455cc5853bf97130711": {
            "text": "Veld “%1$s” van het type “%2$s” wordt niet ondersteund in veld “%3$s”"
        },
