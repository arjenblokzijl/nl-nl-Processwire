{
    "file": "wire/modules/Fieldtype/FieldtypeModule/FieldtypeModule.module",
    "textdomain": "wire--modules--fieldtype--fieldtypemodule--fieldtypemodule-module",
    "translations": {
        "6adf97f83acf6453d4a6a4b1070f3754": {
            "text": "Geen"
        },
        "40e27ece1fd60ce7081fd3084e866820": {
            "text": "Moduletypen"
        },
        "e4b9c7449faedd6b2667e3db22d04cc1": {
            "text": "Vink alle moduletypes aan die in dit veld geselecteerd kunnen worden."
        },
        "17ef61026679e3483b3aebd3e9a2502c": {
            "text": "Type module"
        },
        "716de874a0d74f25c0aa8c444c3a7539": {
            "text": "Voorvoegsel"
        },
        "e40489cd1e7102e35469c937e05c8bba": {
            "text": "Overerving"
        },
        "9a90458e160aa0a5d2615a97caec6854": {
            "text": "De optie ‘prefix’ wordt aanbevolen voor betere prestaties, tenzij deze niet overeenkomt met de module die je in gedachten hebt."
        },
        "4aa842af483898d272ce5ea136a446d3": {
            "text": "Wil je van dit veld een instantie van de geselecteerde module maken?"
        },
        "1d4b3399eb44d29f0188147089a9fb8a": {
            "text": "Als dit aangevinkt is, is de veldwaarde een daadwerkelijke instantie van de geselecteerde module. Als dit niet aangevinkt is, is de veldwaarde een tekenreeks met de klassenaam van de module."
        },
        "bbddef2b960b6e14a0c9510c2312192e": {
            "text": "Optielabel"
        },
        "49ee3087348e8d44e1feda1917443987": {
            "text": "Naam"
        },
        "b78a3223503896721cca1303f776159b": {
            "text": "Titel"
        },
        "3d0e52e8f34a293de17317f094e676b6": {
            "text": "Titel en samenvatting"
        },
        "a749642e2afeea63aac9d550e51abf64": {
            "text": "Invoertype"
        },
        "e0626222614bdee31951d84c64e5e9ff": {
            "text": "Selecteren"
        },
        "d5a4c326398e96cdf97b6d4a3cc300c1": {
            "text": "Keuzerondjes"
        },
        "daf361912b4d4260a6a0c3dc31a60312": {
            "text": "Een optie ‘Geen’ weergeven?"
        },
        "1177fb816ddc2935c2a8bc55d22b93b1": {
            "text": "Type met lege waarde"
        }
    }
}
