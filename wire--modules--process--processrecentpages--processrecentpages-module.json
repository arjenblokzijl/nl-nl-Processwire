    "translations": {
        "fda27fd4e8f31d46c37d6ebb661d4975": {
            "text": "Er zijn (nog) geen pagina's gevonden"
        },
        "0f1af93a396987467471642622b4f372": {
            "text": "Voor deze functie is de permissie ‘page-lister’ vereist"
        },
        "0cd816a2b17a6fd85120a4ffc417ef52": {
            "text": "Recente pagina's"
        },
        "e8ec3c5a66a1458617d385c211485937": {
            "text": "Pagina's die onlangs zijn aangemaakt door %s"
        },
        "6164ab6f0d40bf0dbb4d016d70f22451": {
            "text": "Onlangs aangemaakte pagina's"
        },
        "0fa9b1da7af6dc7c17300d2696d4e840": {
            "text": "Pagina's die onlangs zijn bewerkt door %s"
        },
        "727d0685214d2e29837bf220bd336876": {
            "text": "Onlangs bewerkte pagina's"
        },
        "0d52952360bedad458af277a8f2aeb1e": {
            "text": "in %s"
        },
        "854a4e1057837e016fa0fd26de810760": {
            "text": "Nog een toevoegen"
        },
        "587e304d5de9c56ac7833cb11fbbbcf9": {
            "text": "Klik op een willekeurig item om er nog een van hetzelfde type toe te voegen"
        },
        "67ed6ddb7d890b23166c1bef771e9451": {
            "text": "Bewerkt"
        },
        "0eceeb45861f9585dd7a97a3e36f85c6": {
            "text": "Aangemaakt"
        },
        "2ff3c4fe971c877ac58d0d2ae6d21a1f": {
            "text": "Bewerkt door mij"
        },
        "1914dedd048465ec232e765349041af5": {
            "text": "Door mij gemaakt"
        },
        "47d881f2691b3fe7e1aa6ddd1d9362fa": {
            "text": "Pagina"
        },
        "615d41dc9054191178b392de366b7168": {
            "text": "Bovenliggende pagina"
        },
        "df286bfb6dd8fa62b0271fac208797fe": {
            "text": "Template"
        },
        "848656e110ec0bd90b47b5bf7c961c95": {
            "text": "Aangemaakt"
        },
        "872db811a5e431cc819ba322361af380": {
            "text": "Gewijzigd"
        },
        "7a194bb4dc7991f70455c1068bc10d94": {
            "text": "Laatst aangemaakt"
        }
    }
