    "translations": {
        "f2a6c498fb90ee345d997f888fce3b18": {
            "text": "Verwijder"
        },
        "97154f7c3d4195084cbcb58bc5357c7a": {
            "text": "Reactie #%d (%s)"
        },
        "077821dbbc7b778e3fccdb71e1f8cda3": {
            "text": "ALLE nieuwe reacties"
        },
        "a2c889314eecccf6704dd2427f12b478": {
            "text": "ALLEEN REACTIES"
        },
        "88559a0cfd8250c9d65970cc145c92d4": {
            "text": "UIT"
        },
        "5150f466372999feb1c31b868e087dfc": {
            "text": "Spam wordt automatisch verwijderd na de tijd die in de configuratie van de velden is opgegeven."
        },
        "193a4762fa2301d6e5d9fac2730dbe71": {
            "text": "Dit item wacht op goedkeuring of verwijdering."
        },
        "95742f3daaebcf075ad53961b11fc0dd": {
            "text": "Reactie #%1$d Geplaatst op %2$s door %3$s"
        },
        "d37c550d781bfb93b0088a2470598bcf": {
            "text": "Sterren"
        },
        "8922ee2d287d6d1cad3fd33f6341f512": {
            "text": "E-mailmeldingen:"
        },
        "ec53a8c4f07baed5d8825072c89799be": {
            "text": "Status"
        },
        "84c4dfc8fccf9350a9610e366ae769a5": {
            "text": "Reactie op"
        },
        "6f9e04c43332fd4945f2c933c8eea611": {
            "text": "Citaat"
        },
        "082e55a73f10496681c84231dc1c88f7": {
            "text": "E-mail"
        },
        "15bbb9d0bbf25e8d2978de1168c749dc": {
            "text": "Website"
        },
        "9dffbf69ffba8bc38bc4e01abf4b1675": {
            "text": "Tekst"
        },
        "ece9015e4facb7c419ce80abecfd6852": {
            "text": "Er zijn momenteel geen items om weer te geven."
        },
        "dea78eecface40ce1489d1acdc31eae4": {
            "text": "Opmerking #%d verwijderd"
        },
        "58b6f822b062991647cf2e70b0140352": {
            "text": "%s bijgewerkt voor opmerking #%d"
        },
        "de409f1196a299b23fcbdfaf9efe0740": {
            "text": "Gebruik je liever de commentaarbeheerder in plaats van de editor op de pagina zelf?"
        },
        "33c3c08ba0fba5a5c7cf3200a45dd907": {
            "text": "Als deze optie is ingeschakeld, wordt de gebruiker doorgestuurd naar de speciale reactiemanager om reacties te bewerken."
        },
        "3857c404875aaaa89b52103fed3f5af6": {
            "text": "Dit kan de voorkeur hebben omdat de commentaarbeheerder meer functies heeft en paginering gebruikt."
        },
        "4da50726e74180c03ab1cfe637bb590b": {
            "text": "Beheer van reacties"
        },
        "9e1775dd11710f1858dc1f9c21174ec8": {
            "text": "Biedt een beheerinterface voor het werken met reacties"
        },
        "0cdfb8480c1dfe5241c042249c4d9fae": {
            "text": "Uitgelicht"
        },
        "a12b241da69948907eecb3786cedc5a3": {
            "text": "Goedgekeurd"
        },
        "af4a8ef24b938b7857109b49e38c8969": {
            "text": "In afwachting"
        },
        "39ef1e97d0b7fa0510cd93cd5f2cf99b": {
            "text": "Spam"
        },
        "eebb31a81d2aad4ae64d6dba6909e9eb": {
            "text": "%d metawaarde"
        },
        "7ce7f3b84a8535988430017d4c449643": {
            "text": "%d metawaarden"
        },
        "4a964c69ef2c96e042a8fec38dc97850": {
            "text": "%d opmerking"
        },
        "9c8bfdb79649293332a0195f706f0020": {
            "text": "%d reacties"
        }
    }
