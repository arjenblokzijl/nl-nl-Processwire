        "d050438ea9af830fff49ddbbad2218b0": {
            "text": "Standaard kolommen"
        },
        "6d0999f49ddabda93eae8276595abe62": {
            "text": "Selecteer en sorteer de kolommen die zichtbaar worden in de paginatabel."
        },
        "97bff91e1e9c0a1d8a8cc9a0c1ae88fc": {
            "text": "De gebruiker kan eventueel de zichtbaarheid van de kolommen aanpassen. Deze optie geldt als standaard."
        },
        "0e305a04b5eb6dc8bf502625710a74d3": {
            "text": "De wijzigingen die hier gemaakt worden zijn direct zichtbaar in de resultaten hieronder."
        },
        "60170ad1f8db03dc180ee0ced484b19f": {
            "text": "Welke kolommen zichtbaar maken in de resultaten"
        },
        "0c8ee3eeadc96eeeeb24e2a6dc9d4a5e": {
            "text": "Welke pagina's zichtbaar maken"
        },
        "3361493ce22b609b5d11f463c8bd8c6a": {
            "text": "De opgegeven 'include='-modus is hier niet toegestaan."
        },
        "e418dc3d6d68592a1932bb1446975acb": {
            "text": "Niet alle opgegeven templates zijn bewerkbaar. Alleen 'include=verborgen' is toegestaan"
        },
        "12b585ee7c6e8dca3790262f321f3823": {
            "text": "Er zijn geen templates opgegeven, dus 'include=verborgen' is de maximaal toegestane include-modus"
        },
        "a5158728109d8e67ae31b7b02bdc8b86": {
