{
    "file": "wire/modules/Process/ProcessLogger/ProcessLogger.module",
    "textdomain": "wire--modules--process--processlogger--processlogger-module",
    "translations": {
        "a422bfafc484bafeef9ccbfeb175c216": {
            "text": "Maak een logbestand aan of voeg er gegevens aan toe via de API:"
        },
        "872e46a716d24989bf3199d28e4ae86e": {
            "text": "Verwijderd logboek: %s"
        },
        "f33458f02cd71a8319c79c2f4d89c947": {
            "text": "Het logbestand “%s” is ingekort (bevat nu %d vermeldingen)"
        },
        "02bb48ec8c3eb6796671313f290e943d": {
            "text": "Nieuwe logboekvermelding opgeslagen in “%s”"
        },
        "4ad21358c22f2457f4a4c6495c68ddf6": {
            "text": "De tekst van het logboekitem was leeg"
        },
        "58840cc813684ae1c5cb61d83a4c974f": {
            "text": "Hulpprogramma’s"
        },
        "dc770a451931e3eb28348451a1ef9896": {
            "text": "Tekst zoeken"
        },
        "4777bbe3c06c7939e97101b4589ba1eb": {
            "text": "Datum vanaf"
        },
        "d24e4fa285c1eab355817ed6c38ec1bd": {
            "text": "Datum tot"
        },
        "06df33001c1d7187fdd81ea1f5b277aa": {
            "text": "Acties"
        },
        "de36914cd9d030bca299ef13e59e81fc": {
            "text": "Kies hieronder een actie. Je wordt gevraagd om op een knop te klikken voordat de actie wordt uitgevoerd."
        },
        "801ab24683a4a8c433c6eb40c48bcd9d": {
            "text": "Downloaden"
        },
        "1c53c4bdef63da21f7d99ba3bc5999f9": {
            "text": "Uitbreiden (item toevoegen)"
        },
        "02f9418b682bcf39e6426bc2981e2b8a": {
            "text": "Inkorten"
        },
        "d7e4a58b047e3d80c673e8689567c66b": {
            "text": "Verwijderen"
        },
        "346d021dc6749fe81c1f0faee3a38831": {
            "text": "Verdeel over # dagen"
        },
        "6ae864586a6fe2c99b1501c4c20e2e38": {
            "text": "Beperk de grootte van het logbestand zodat het alleen vermeldingen van de laatste [n] dagen bevat."
        },
        "e3a6297e7ba64ab87a04b472d2d2330e": {
            "text": "Moet 1 of hoger zijn."
        },
        "83f5d3fdcb74c638ae403fae1637a1fc": {
            "text": "Nieuw logboekbericht"
        },
        "c397f5454fbbd15045aaacf88b43888e": {
            "text": "Verwijder dit logbestand nu"
        },
        "9ac3ee6fa6d85d02c8d53149a96a0bcd": {
            "text": "Verwijder dit logboek nu (definitief verwijderen)"
        },
        "504e5b0396525461611c2daa17c1a420": {
            "text": "Voeg dit logboekitem toe"
        },
        "85b023a5435c54612ef3316cbc37a660": {
            "text": "Download dit logbestand nu"
        },
        "5157e3c765af93679ea07052f30f0a6e": {
            "text": "actueel"
        },
        "1058f3258b7dca7c4693166c425b968d": {
            "text": "Geen overeenkomende logboekvermeldingen"
        },
        "75d8bea19790a638a8dde30fd475dba6": {
            "text": "404 niet gevonden"
        },
        "b2d37ae1cedf42ff874289b721860af2": {
            "text": "Logs"
        },
        "527b296f2533d0e979933116081467a8": {
            "text": "Bekijk en beheer systeemlogboeken."
        },
        "ab11deae48aaa0e5cadf227120ed4ade": {
            "text": "Naam"
        },
        "872db811a5e431cc819ba322361af380": {
            "text": "Gewijzigd"
        },
        "922e48e67eab1e2b2673f5d44a6fbafd": {
            "text": "Vermeldingen"
        },
        "57728bfeef48fd1206314f0cd1c2576a": {
            "text": "Grootte"
        },
        "4c35d99800510d64691a870b65d277f4": {
            "text": "Datum/tijd"
        },
        "88cfe14e9a1a3300a1f5ef50f73a648b": {
            "text": "Gebruiker"
        },
        "6ca734172827db670a1e2ea88e6c5401": {
            "text": "URL"
        },
        "9f3af3dbda7832b613a27b731cc3ca02": {
            "text": "Tekst"
        },
        "bd350ab4ad8284276668d82be6b20b52": {
            "text": "%d log"
        },
        "712684fe92736fe32b1c2eb87d2360c7": {
            "text": "%d logs"
        },
        "064a2c9034205289d020252829c41052": {
            "text": "Eén nieuw logboekbericht op pagina 1"
        },
        "b9dc13817999fcd3ea5967c020b5c043": {
            "text": "Meerdere nieuwe logboekvermeldingen op pagina 1"
        },
        "5118ea88654d8338b03da5c0b62c1f42": {
            "text": "Plus %d eerdere duplicaten "
        },
        "c9ac43f375c0387b8a7ff29615abc018": {
            "text": "Plus %d eerdere duplicaten"
        }
    }
}
