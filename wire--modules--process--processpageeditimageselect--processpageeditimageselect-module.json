        "575f5f86d2c7ea113c6710c1037c4465": {
            "text": "Opslaan..."
        },
        "a7d784a6301793f61c070496d6988d36": {
            "text": "Aanpassen..."
        },
        "93cba07454f06a4a960172bbd6e2a435": {
            "text": "Ja"
        },
        "b1a0a023c5df1b1928e1176fca487837": {
            "text": "Nee, gebruik %s"
        },
        "a7ef116917746995c6efb74b77261e93": {
            "text": "Bijschrift?"
        },
        "82e8dd04a8fd3563e8e703b0ab6620d4": {
            "text": "De bijschrifttekst voer je in de editor in nadat je de afbeelding hebt ingevoegd."
        },
        "b9869a2e0129f044fca87d4b4f7664f0": {
            "text": "Tekst voor het bijschrift hier"
        },
        "5e470c96fb73af827111043d60af3dbe": {
            "text": "Naar rechts draaien"
        },
        "f3d4b8039718518b45713ae64c12de37": {
            "text": "Naar links draaien"
        },
        "2f96dd2b9788ed9ecbc6f41c312bf455": {
            "text": "Horizontaal spiegelen"
        },
        "8373d2f18e29920f78459f34d71040ad": {
            "text": "Verticaal spiegelen"
        },
        "575acda05a24ee8b606cee4f25024afe": {
            "text": "Je hebt geen toegang om afbeeldingen op deze pagina te bewerken."
        },
        "5d13ae1a65403891ac0fe044f3acc865": {
            "text": "Er zijn geen afbeeldingsvelden (image fields) op deze pagina. Kies een andere pagina om afbeeldingen uit te kiezen."
        },
        "d695a4d4ae7091badbe5c20c5b064bac": {
            "text": "Er staan geen afbeeldingen op deze pagina. Upload een afbeelding of selecteer afbeeldingen van een andere pagina."
        },
        "83ea3ed3245ed2ce30aabecdc6b4d354": {
            "text": "Afbeeldingen op de pagina:"
        },
        "48448404ecc9e95975b334dbe421c0bd": {
            "text": "Wanneer je afbeeldingen van een andere pagina wilt selecteren, kies je hieronder de pagina."
        },
        "1f98842c354dc496970446bce14f4c50": {
            "text": "Afbeelding uploaden"
        },
        "e853a6aca1b442d161c2642e88346bf9": {
            "text": "Geen uitlijning"
        },
        "8524de963f07201e5c086830d370797f": {
            "text": "Laden..."
        },
        "fef2a86d13179e1022a0f692ad9f521b": {
            "text": "Er zijn geen wijzigingen nodig voor de afbeeldingsvariaties."
        },
        "46ce1195125fefcac9df32093fb8f238": {
            "text": "Geen wijzigingen gemaakt"
        },
        "0a52da7a03a6de3beefe54f8c03ad80d": {
            "text": "Origineel"
        },
        "4ea9ef823adbf374c74a5ef6316a18e2": {
            "text": "%s, zoals hierboven"
        },
        "a39537e1c6a1b744127450b81c4f8173": {
            "text": "Verwijderde variant"
        },
        "966c5c54ae383420f05957c520436202": {
            "text": "Fout bij verwijderen variant"
        },
        "a2c7bdf75d9141ef485ca345d5a3b50c": {
            "text": "Verwijder gekozen"
        },
        "d3d2e617335f08df83599665eef8a418": {
            "text": "Sluiten"
        },
        "68155ca6e2858626c370f0fb3ea9bfc5": {
            "text": "HiDPI/Retina checkbox standaard aan?"
        },
        "3608b24ec08977c76c40c8514f3bcbd5": {
            "text": "Vink deze optie aan indien je HiDPI/Retina checkbox standaard aangevinkt wilt hebben voor nieuwe afbeeldingen."
        },
        "6cefecef91de145c3ca72fb3d5e59702": {
            "text": "Genereer geen miniatuurafbeeldingen"
        },
        "a60c49010df18fff7f99db0d0d5a1522": {
            "text": "Indien aangevinkt wordt de afbeeldingsselectie gebruikt op volledige grootte in plaats van de miniatuurafbeelding."
        },
        "36171be725b020fde0f22b3ceb047280": {
            "text": "Veldnamen overslaan voor selectie"
        },
        "fd8d17a2ebc3643f78fc97b8e5c3a7f3": {
            "text": "Geef de namen op van afbeeldingsvelden (gescheiden door een spatie) waarvoor je niet wilt dat deze module gebruikt wordt."
        },
        "0bedb7a49466cc5abddacd2003be55b3": {
            "text": "Toon geen breedte attribuut bij afbeeldingstags."
        },
        "522779383d7b7d46168fcc8ae1c5d4a5": {
            "text": "Standaard voegt deze module breedte-attributen toe aan de img-tag. Als je responsieve afbeeldingen gebruikt, wil je dit gedrag misschien uitschakelen. Vink het vakje aan om de breedte- en hoogte-attributen uit te schakelen."
        },
        "66e1d61daf21cfd5a9a0c3c172d7215d": {
            "text": "We raden af deze checkbox te gebruiken aangezien het de werking van een aantal functions kan verstoren."
        },
        "7fde437e01b597d729484cfc830eb4c5": {
            "text": "Aangeraden waarde:"
        },
        "9909fb0aacb4a219f4b3cb8f57f63a87": {
            "text": "Links uitlijnen class"
        },
        "9d2836f3ff372cd7964b90d118710202": {
            "text": "In het midden uitlijnen class"
        },
        "5e37ad68682589a77a924cdffb018f23": {
            "text": "Rechts uitlijnen class"
        },
        "0220ca2a43c59a70842cafc215b6430e": {
            "text": "Gemaakt om in textarea te plaatsen"
        },
        "4e5c9b873df1e8716656250c63342361": {
            "text": "HiDPI/Retina"
        },
        "8cc1cfd47373070e2d8f4fc7d367abf3": {
