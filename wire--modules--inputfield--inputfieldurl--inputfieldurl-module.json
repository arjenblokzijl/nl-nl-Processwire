            "text": "Let op: %s is toegevoegd"
        },
        "e6b391a8d2c4d45902a23a8b6585703d": {
            "text": "URL"
        },
        "1a30197ddff7dc9d65d91f285125cdc2": {
            "text": "URL in geldig formaat"
