    "translations": {
        "d388632d05e8826abe4b95de0b110529": {
            "text": "Bijsnijden"
        },
        "e24ee2487879116dcab772c0ac4fe341": {
            "text": "Focus"
        },
        "a4374740662193b987e63eb5b727c994": {
            "text": "Variaties"
        },
        "f4843c1c797abf1a256c8802b6cd9f51": {
            "text": "Afmetingen"
        },
        "b18c29b8470190a02813415a04a2191f": {
            "text": "Bestandsgrootte"
        },
        "7dce122004969d56ae2e0245cb754d35": {
            "text": "Bewerken"
        },
        "f6462f94fa453f425245109b06f64d22": {
            "text": "Sleep hierboven nieuwe afbeeldingen naar toe"
        },
        "382b0f5185773fa0f67a8ed8056c7759": {
            "text": "N.v.t."
        },
        "f4795ac01103c68bc75e637665b7bd12": {
            "text": "Dit afbeeldingenveld bevat mogelijk nog niet-opgeslagen wijzigingen die na deze actie verloren kunnen gaan. Sla je wijzigingen op voordat je gaat bijsnijden, of dubbelklik op de knop om toch door te gaan."
        },
        "1729a56cfc89021478498fe0c89a843a": {
            "text": "Zichtbaarheid"
        },
        "7acdf85c69cc3c5305456a293524386e": {
            "text": "Verborgen"
        },
        "d6a369d29506d3151a76c33791fc80b6": {
            "text": "sleep een nieuw afbeeldingsbestand erin om het te vervangen"
        },
        "819258e827e9ef9ba926940f30b2697e": {
            "text": "Sleep de cirkel naar het middelpunt van de focus"
        },
        "f0b3dbf5ce5950ff0ecc7dbea5f8a874": {
            "text": "Hierboven staan oudere/minder goede miniatuurafbeeldingen – vink dit vakje aan om ze opnieuw te genereren."
        },
        "126b21ce46c39d12c24058791a236777": {
            "text": "Ongeldige afbeelding"
        },
        "41cfe40655c4b51507eff9d22bd777f2": {
            "text": "Afbeelding %s voldoet niet aan de minimale afmetingen"
        },
        "5e244fccb2d4cda18bebf756dacce94c": {
            "text": "De afbeelding van %s is groter dan de maximaal toegestane grootte"
        },
        "7e4cc6c00140cefcecd178df1836fbba": {
            "text": "Afbeelding is aangepast aan het maximum toegestane formaat"
        },
        "180481333cbd9cb56beaae68deab6541": {
            "text": "Klik om de naam te wijzigen"
        },
        "3311dff3fd166c37c1bf2e9014cdee71": {
            "text": "Oorspronkelijk:"
        },
        "96733a97d96b04ddd6e06cdf3147df1e": {
            "text": "Niet bewerkbaar."
        },
        "06df33001c1d7187fdd81ea1f5b277aa": {
            "text": "Acties"
        },
        "9356bea0f207cd50faacd40798850038": {
            "text": "Actie die wordt uitgevoerd bij het opslaan."
        },
        "9ffbd422925a6839ee820ddbc59278c5": {
            "text": "Omdraaien"
        },
        "8d2de5368588552fbae54044ac5c7b3d": {
            "text": "Draaien"
        },
        "ed75712b0eb1913c28a3872731ffd48d": {
            "text": "Dupliceren"
        },
        "9d639c16d0e22f1f4f9b79593e260ce6": {
            "text": "Variaties verwijderen"
        },
        "baca1adb243ae63002bbb02b3ce5c28d": {
            "text": "Variaties opnieuw opbouwen"
        },
        "40c760714d188227815e2e1ed3369c29": {
            "text": "Focus verwijderen"
        },
        "c9b416167392c2b301810695b92efa12": {
            "text": "vert"
        },
        "2ef2dfb893d25c30e3e2bda1a10c8952": {
            "text": "horiz"
        },
        "f6cb3e816496528d4187db53bc66567f": {
            "text": "beide"
        },
        "5fb63579fc981698f97d55bfecb213ea": {
            "text": "Kopiëren"
        },
        "36bb6559696dc9124986ae120515984f": {
            "text": "Plakken"
        },
        "e4ddc7e3d69547eea44ee08c02eb350d": {
            "text": "Verminder met 50%"
        },
        "60e7841801c8734e320b527cbfa8d022": {
            "text": "Zwart-wit"
        },
        "b84a9a38377dc1ab6c6d5005cb461f0d": {
            "text": "Sepia"
        },
        "62a5e490880a92eef74f167d9dc6dca0": {
            "text": "Verbergen"
        },
        "c41263e9868393a11717a8fd89de95f8": {
            "text": "Zichtbaar maken"
        },
        "36400352f439e8894099e79dc33fada1": {
            "text": "Alle oude thumbnails opnieuw gemaakt"
        },
        "0cb9400e4e73f627d6587cf549c60907": {
            "text": "Bestand %1$s gedupliceerd => %2$s"
        },
        "80a599081d30053c4cf6bc91230a9e6c": {
            "text": "Actie „%1$s“ uitgevoerd op bestand %2$s"
        },
        "a45c16f718396868c97a72efcc571842": {
            "text": "Actie „%1$s“ is mislukt voor bestand %2$s"
        },
        "ac8883f9998c8b328a96855575eebcc5": {
            "text": "Er is geen handler gevonden voor actie „%1$s“ in bestand %2$s"
        },
        "fff0d600f8a0b5e19e88bfb821dd1157": {
